# LojaCerta · variáveis de ambiente (copie para .env e preencha — NUNCA commite o .env)
# O build lê este arquivo: npm run build (demo) | npm run build:prod (produção)

# demo       → tudo mockado (apresentações, homologação) — padrão se vazio
# production → exige API_BASE + SUPABASE_ANON_KEY; mock é bloqueado por guard
ENV=production

# URL pública do site (canonical, OG, e-mails, redirects de auth)
SITE_URL=https://jrsistemasetecnologiabr-bit.github.io/Projeto-empresa

# Supabase (Settings → API)
API_BASE=https://qmqllssextbxwwphawod.supabase.co
SUPABASE_ANON_KEY=

# Cobrança
BILLING_PROVIDER=asaas
STRIPE_PK=

# Anti-abuso do teste grátis (v5) — espelho do modo demo embutido no bundle.
# Em produção a regra real vive no servidor (Edge Function "api" + migração v5):
#   supabase secrets set TRIAL_LIMIT_PER_IP=1 TRIAL_LIMIT_PER_DEVICE=1
TRIAL_IP_LIMIT=1
TRIAL_DEVICE_LIMIT=1

# Segredos server-side (NÃO vão para o front; definir no painel do Supabase:
# Project Settings → Edge Function Secrets, ou via CLI `supabase secrets set`)
# ASAAS_API_KEY=          → chave da API Asaas ($aact_…) — checkout/assinaturas
# ASAAS_ENV=sandbox       → "production" SOMENTE quando for cobrar de verdade
# ASAAS_WEBHOOK_TOKEN=    → mesmo token configurado no webhook do painel Asaas
# Resend (e-mails transacionais) NÃO é secret de Edge: fica no Vault do banco
#   select vault.create_secret('re_xxx', 'resend_api_key');
#   select vault.create_secret('LojaCerta <nao-responda@SEU-DOMINIO>', 'email_from');
# STRIPE_WEBHOOK_SECRET=  (legado, não usado)
# SUPABASE_SERVICE_ROLE_KEY=
# DEV_PIN → 2º fator da escrita de cobrança (billing.activate_plan/suspend_tenant)

# Conta de teste para o smoke test (tools/run-tests.sh → tests/smoke.test.js).
# Use um usuário COMUM (não-dev) de uma loja de testes — o teste só lê e
# tenta escritas que DEVEM ser barradas (RLS/guard), nada é alterado.
TEST_EMAIL=
TEST_PASSWORD=
